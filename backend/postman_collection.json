{
  "info": {
    "name": "Bus Booking Platform API v1",
    "description": "Complete API collection for the Bus Booking Platform.\n\nBase URL: {{base_url}}/api/v1/\n\nAuth: Token-based (send `Authorization: Token <token>` header)\n\nFlow: Send OTP → Verify OTP → Register → Use Token for all endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "admin_token", "value": "" },
    { "key": "operator_token", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "bus_id", "value": "" },
    { "key": "booking_id", "value": "" },
    { "key": "payment_id", "value": "" },
    { "key": "review_id", "value": "" },
    { "key": "document_id", "value": "" },
    { "key": "notification_id", "value": "" },
    { "key": "photo_id", "value": "" },
    { "key": "amenity_id", "value": "" },
    { "key": "availability_id", "value": "" },
    { "key": "coupon_code", "value": "WELCOME10" }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints (OTP-based via Supabase)",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/users/auth/send-otp/", "host": ["{{base_url}}"], "path": ["api", "v1", "users", "auth", "send-otp", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919876543210\"\n}"
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/users/auth/verify-otp/", "host": ["{{base_url}}"], "path": ["api", "v1", "users", "auth", "verify-otp", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919876543210\",\n  \"otp\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "  pm.collectionVariables.set('token', jsonData.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/users/auth/register/", "host": ["{{base_url}}"], "path": ["api", "v1", "users", "auth", "register", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919876543210\",\n  \"full_name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"role\": \"customer\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "  pm.collectionVariables.set('token', jsonData.token);",
                  "}",
                  "if (jsonData.user && jsonData.user.id) {",
                  "  pm.collectionVariables.set('user_id', jsonData.user.id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
