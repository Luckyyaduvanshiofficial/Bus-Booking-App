    {
      "name": "Bookings",
      "description": "Booking lifecycle: create → respond → pay → complete/cancel",
      "item": [
        {
          "name": "Create Booking (Customer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Token {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/bookings/", "host": ["{{base_url}}"], "path": ["api", "v1", "bookings", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bus\": \"{{bus_id}}\",\n  \"pickup_location\": \"Mumbai Central\",\n  \"dropoff_location\": \"Pune Station\",\n  \"pickup_date\": \"2026-04-01\",\n  \"return_date\": \"2026-04-02\",\n  \"num_passengers\": 25,\n  \"trip_type\": \"round_trip\",\n  \"distance_km\": 150\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "  pm.collectionVariables.set('booking_id', jsonData.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List My Bookings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Token {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/bookings/", "host": ["{{base_url}}"], "path": ["api", "v1", "bookings", ""] }
          }
        },
        {
          "name": "Get Booking Detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Token {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/bookings/{{booking_id}}/", "host": ["{{base_url}}"], "path": ["api", "v1", "bookings", "{{booking_id}}", ""] }
          }
        },
        {
          "name": "Respond to Booking (Operator)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Token {{operator_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/bookings/{{booking_id}}/respond/", "host": ["{{base_url}}"], "path": ["api", "v1", "bookings", "{{booking_id}}", "respond", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"confirm\"\n}"
            }
          }
        },
        {
          "name": "Cancel Booking (Customer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Token {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/bookings/{{booking_id}}/cancel/", "host": ["{{base_url}}"], "path": ["api", "v1", "bookings", "{{booking_id}}", "cancel", ""] }
          }
        },
        {
          "name": "Complete Booking (Operator)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Token {{operator_token}}" }
            ],
